+// Transparenz: hinter dem Bild folgt ein zweiter Bildblock ("RI", Länge, 0, Kopflänge, dann Kopf wie readRImage)
+// mit einer 8-Bit-Maske gleicher Größe, Zeilen auf 4 Byte aufgefüllt. Ohne Maske bleibt die Leseposition gleich.
+void libcdr::CDRParser::readBmpMask(unsigned width, unsigned height, std::vector<unsigned char> &mask, librevenge::RVNGInputStream *input)
+{
+  const long start = input->tell();
+  if (getRemainingLength(input) > 78 && readU8(input) == 0x52 && readU8(input) == 0x49)
+  {
+    input->seek(8, librevenge::RVNG_SEEK_CUR);
+    const unsigned headerLength = readU32(input);
+    input->seek(8, librevenge::RVNG_SEEK_CUR);
+    const unsigned maskWidth = readU32(input);
+    const unsigned maskHeight = readU32(input);
+    input->seek(4, librevenge::RVNG_SEEK_CUR);
+    const unsigned maskBpp = readU32(input);
+    input->seek(4, librevenge::RVNG_SEEK_CUR);
+    const unsigned maskSize = readU32(input);
+    if (maskWidth == width && maskHeight == height && maskBpp == 8 && height && maskSize / height >= width
+        && headerLength >= 46 && input->seek(start + headerLength, librevenge::RVNG_SEEK_SET) == 0
+        && maskSize <= getRemainingLength(input))
+    {
+      unsigned long numBytesRead = 0;
+      const unsigned char *buffer = input->read(maskSize, numBytesRead);
+      if (numBytesRead == maskSize)
+        mask.assign(buffer, buffer + maskSize);
+    }
+  }
+  input->seek(start, librevenge::RVNG_SEEK_SET);
+}
